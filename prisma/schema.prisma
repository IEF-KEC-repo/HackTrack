// HackTrack Prisma Relational Data Model
// Edition-partitioned schema with full support for configurable event stages,
// multi-role RBAC, weighted rubrics, 3-reviewer evaluations, artifacts, and audit logs.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum EditionRole {
  SUPER_ADMIN
  COORDINATOR_MANAGE
  COORDINATOR_VIEW
  EVALUATOR
  MENTOR
  PARTICIPANT
}

enum EditionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ReviewType {
  ASYNC_MULTI_REVIEWER
  LIVE_PANEL
}

enum EventStatus {
  UPCOMING
  REGISTRATION_OPEN
  SUBMISSION_OPEN
  SUBMISSION_LOCKED
  EVALUATION_ACTIVE
  EVALUATION_LOCKED
  COMPLETED
}

enum TeamStatus {
  DRAFT
  REGISTERED
  SUBMITTED
  CHANGES_REQUESTED
  SHORTLISTED
  IDEATHON_EVALUATED
  INCL_INNOVATZ
  CPR_ACTIVE
  POC_QUALIFIED
  DEMO_DAY_FINALIST
  COMPLETED
  ELIMINATED
  WITHDRAWN
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TeamRole {
  LEAD
  MEMBER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

enum TeamHealth {
  GREEN
  YELLOW
  RED
}

enum NotificationType {
  SLIDES_LINK_MISSING
  MILESTONE_DUE_SOON
  MILESTONE_OVERDUE
  CHECKIN_DUE
  CHECKIN_OVERDUE
  REVIEW_ASSIGNED
  EVALUATION_REOPENED
  FEEDBACK_RELEASED
  ANNOUNCEMENT
  TEAM_INVITE
  STAGE_DECISION
}

enum StageDecision {
  CONTINUE
  CONDITIONAL
  EXIT
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED_PREFERENCE
}

// ----------------------------------------------------
// CORE ENTITIES
// ----------------------------------------------------

model Edition {
  id           String        @id @default(cuid())
  name         String        // e.g. "HackTrack 2026"
  slug         String        @unique // e.g. "ht26"
  academicYear String        // e.g. "2025-2026"
  status              EditionStatus @default(DRAFT)
  startDate           DateTime
  endDate             DateTime
  clonedFromEditionId String?
  createdAt           DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  events       Event[]
  teams        Team[]
  memberships  EditionMembership[]
  invitations  Invitation[]
  milestones   Milestone[]
  teamMilestones TeamMilestone[]
  conflicts    ConflictOfInterest[]
  auditLogs    AuditLog[]
  notifications Notification[]
  announcements Announcement[]

  @@index([status])
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  avatarUrl    String?
  globalRole   GlobalRole  @default(USER)
  isVerified   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  memberships           EditionMembership[]
  teamMemberships       TeamMember[]
  mentoredTeams         Team[]              @relation("TeamMentor")
  evaluations           Evaluation[]        @relation("Evaluator")
  checkInsAsMentor      CheckIn[]           @relation("MentorCheckIns")
  sentInvitations       Invitation[]        @relation("InvitedByUser")
  declaredConflicts     ConflictOfInterest[] @relation("EvaluatorConflicts")
  auditLogs             AuditLog[]          @relation("UserAuditLogs")
  notifications         Notification[]
  notificationPreference NotificationPreference?
  authoredAnnouncements Announcement[]      @relation("AuthoredAnnouncements")
  announcementReads     AnnouncementRead[]
  emailDeliveryLogs     EmailDeliveryLog[]
  eventDecisionsMade    EventDecision[]     @relation("DecidedByCoordinator")

  @@index([email])
}

model EditionMembership {
  id        String      @id @default(cuid())
  userId    String
  editionId String
  role      EditionRole @default(PARTICIPANT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([userId, editionId])
  @@index([editionId, role])
}

model Event {
  id                 String      @id @default(cuid())
  editionId          String
  name               String      // e.g. "Ideathon", "Innovatz", "CPR 1", "POC", "Demo Day"
  slug               String      // e.g. "ideathon"
  sequenceIndex      Int         // 1, 2, 3...
  reviewType         ReviewType  @default(LIVE_PANEL)
  status             EventStatus @default(UPCOMING)
  submissionDeadline DateTime?
  evaluationDeadline DateTime?
  uploadsEnabled        Boolean     @default(false)
  evaluatorCountPerTeam Int         @default(3)
  feedbackReleased      Boolean     @default(false)
  leaderboardPublished  Boolean     @default(false)
  decisionsRecorded     Boolean     @default(false)
  isCalibrationActive   Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  edition     Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  rubrics     Rubric[]
  submissions Submission[]
  evaluations Evaluation[]
  milestones  Milestone[]
  teamMilestones TeamMilestone[]
  announcements  Announcement[]
  decisions      EventDecision[]

  @@unique([editionId, sequenceIndex])
  @@unique([editionId, slug])
  @@index([editionId, status])
}

model Team {
  id             String     @id @default(cuid())
  editionId      String
  regCode        String     @unique // e.g. "HT26-T001"
  name           String
  track          String?
  status         TeamStatus @default(DRAFT)
  slidesUrl      String?
  embedSlidesUrl String?
  mentorId       String?

  // Step 1: Ideathon Registration Fields
  problemStatement        String?
  solutionAbstract        String?

  // Step 2: Detailed Idea Fields (Unlocked when Shortlisted)
  techStack               String?
  architectureDescription String?
  githubUrl               String?
  risksAndMitigation      String?
  hardwareBOM             String?

  // Coordinator Feedback & Change Requests
  coordinatorFeedback     String?
  changesRequestedAt      DateTime?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  edition     Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  mentor      User?        @relation("TeamMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  members     TeamMember[]
  teamInvites TeamInvite[]
  submissions Submission[]
  evaluations Evaluation[]
  checkIns    CheckIn[]
  teamMilestones TeamMilestone[]
  conflicts   ConflictOfInterest[]
  artifacts   Artifact[]
  announcements Announcement[]
  decisions   EventDecision[]

  @@index([editionId, status])
  @@index([regCode])
}

model TeamInvite {
  id        String           @id @default(cuid())
  teamId    String
  email     String
  role      TeamRole         @default(MEMBER)
  token     String           @unique
  status    TeamInviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
  @@index([token])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Submission {
  id             String           @id @default(cuid())
  teamId         String
  eventId        String
  roundNumber    Int              @default(1)
  notes          String?
  slidesUrl      String?
  embedSlidesUrl String?
  status         SubmissionStatus @default(DRAFT)
  submittedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artifacts Artifact[]

  @@unique([teamId, eventId, roundNumber])
  @@index([eventId, status])
}

model Artifact {
  id           String   @id @default(cuid())
  teamId       String
  submissionId String?
  fileType     String   // e.g. "SLIDES_LINK", "REPORT_PDF", "CODE_ARCHIVE"
  originalName String
  storedName   String   // Renamed to: {regCode}_{sanitizedOriginalName}
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  createdAt    DateTime @default(now())

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  teamMilestones TeamMilestone[]

  @@index([teamId])
  @@index([storedName])
}

model Rubric {
  id             String      @id @default(cuid())
  eventId        String
  name           String      // e.g. "Ideathon Evaluation Rubric"
  totalMaxPoints Float       @default(100.0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  event    Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  criteria Criterion[]

  @@index([eventId])
}

model Criterion {
  id               String   @id @default(cuid())
  rubricId         String
  title            String   // e.g. "Technical Innovation"
  description      String?
  maxPoints        Float    // e.g. 25.0
  weightPercentage Float    // e.g. 25.0%
  anchors          Json?    // Array of { level: number, label: string, description: string }
  sequenceOrder    Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rubric           Rubric            @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  evaluationScores EvaluationScore[]

  @@index([rubricId])
}

model Evaluation {
  id              String           @id @default(cuid())
  eventId         String
  teamId          String
  evaluatorId     String
  status          EvaluationStatus @default(DRAFT)
  rawTotalScore   Float?
  normalizedScore Float?
  generalFeedback    String?
  isCalibration      Boolean          @default(false)
  isOutlierReview    Boolean          @default(false)
  scheduledSlotStart DateTime?
  scheduledSlotEnd   DateTime?
  roomOrMeetingUrl   String?
  reopenedAt         DateTime?
  reopenedById       String?
  reopenReason       String?
  submittedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evaluator User              @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  scores    EvaluationScore[]

  @@unique([eventId, teamId, evaluatorId])
  @@index([eventId, status])
  @@index([evaluatorId])
}

model EvaluationScore {
  id           String  @id @default(cuid())
  evaluationId String
  criterionId  String
  score        Float
  feedback     String?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  Criterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
  @@index([evaluationId])
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum MilestoneSource {
  COORDINATOR_MANDATORY
  TEAM_CUSTOM
}

enum EvidenceType {
  LINK
  FILE
}

model Milestone {
  id          String   @id @default(cuid())
  editionId   String
  eventId     String?
  title       String
  description String?
  dueDate     DateTime
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())

  edition        Edition         @relation(fields: [editionId], references: [id], onDelete: Cascade)
  event          Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  teamMilestones TeamMilestone[]

  @@index([editionId])
}

model TeamMilestone {
  id             String          @id @default(cuid())
  teamId         String
  editionId      String
  eventId        String?
  milestoneId    String?
  title          String
  description    String?
  dueDate        DateTime
  source         MilestoneSource @default(COORDINATOR_MANDATORY)
  status         MilestoneStatus @default(NOT_STARTED)
  isOverdue      Boolean         @default(false)
  isDueSoon      Boolean         @default(false)
  evidenceType   EvidenceType?
  evidenceUrl    String?
  evidenceFileId String?
  evidenceNotes  String?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  edition      Edition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  event        Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  evidenceFile Artifact?  @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([editionId])
  @@index([dueDate])
}

model CheckIn {
  id              String     @id @default(cuid())
  teamId          String
  mentorId        String?
  meetingDate     DateTime   @default(now())
  health          TeamHealth @default(GREEN)
  notes           String?
  actionItems     String?
  progressNotes   String?
  blockers        String?
  nextGoals       String?
  evidenceUrl     String?
  submittedByRole String     @default("TEAM")
  submittedAt     DateTime   @default(now())
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  team   Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mentor User? @relation("MentorCheckIns", fields: [mentorId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([mentorId])
}

model Invitation {
  id          String      @id @default(cuid())
  email       String
  editionId   String
  role        EditionRole @default(PARTICIPANT)
  token       String      @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime    @default(now())

  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([editionId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model AuditLog {
  id            String   @id @default(cuid())
  editionId     String?
  actorId       String?
  action        String   // e.g. "TEAM_PROMOTED", "SCORE_NORMALIZED", "RUBRIC_UPDATED"
  entityType    String   // e.g. "Team", "Evaluation", "Event"
  entityId      String
  previousState String?  // JSON string
  newState      String?  // JSON string
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  edition Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  actor   User?    @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([editionId])
  @@index([actorId])
  @@index([entityType, entityId])
}

model ConflictOfInterest {
  id          String   @id @default(cuid())
  editionId   String
  evaluatorId String
  teamId      String
  reason      String?
  declaredAt  DateTime @default(now())

  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  evaluator User    @relation("EvaluatorConflicts", fields: [evaluatorId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([evaluatorId, teamId])
  @@index([editionId])
  @@index([evaluatorId])
  @@index([teamId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  editionId String?
  type      NotificationType
  title     String
  message   String
  actionUrl String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  dedupKey  String?          @unique
  metadata  String?          // JSON payload
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([editionId])
  @@index([createdAt])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  emailEnabled        Boolean  @default(true)
  inAppEnabled        Boolean  @default(true)
  notifyAnnouncements Boolean  @default(true)
  notifyMilestones    Boolean  @default(true)
  notifyCheckIns      Boolean  @default(true)
  notifyEvaluations   Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String               @id @default(cuid())
  editionId   String
  authorId    String
  title       String
  content     String
  priority    AnnouncementPriority @default(NORMAL)
  pinned      Boolean              @default(false)
  targetRole  EditionRole?         // null = all roles in edition
  eventId     String?              // null = all events
  teamId      String?              // null = all teams
  publishedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  edition Edition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  author  User               @relation("AuthoredAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)
  event   Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  team    Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  reads   AnnouncementRead[]

  @@index([editionId, publishedAt])
  @@index([targetRole])
  @@index([eventId])
  @@index([teamId])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

model EmailDeliveryLog {
  id             String              @id @default(cuid())
  recipientEmail String
  userId         String?
  subject        String
  triggerType    String
  status         EmailDeliveryStatus @default(QUEUED)
  idempotencyKey String              @unique
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([recipientEmail])
  @@index([triggerType])
  @@index([status])
}

model EventDecision {
  id          String        @id @default(cuid())
  eventId     String
  teamId      String
  decision    StageDecision
  notes       String?
  decidedById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  decidedBy   User          @relation("DecidedByCoordinator", fields: [decidedById], references: [id], onDelete: Cascade)

  @@unique([eventId, teamId])
  @@index([eventId, decision])
}

