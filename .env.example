# ==============================================================================
# HackTrack Platform — Localhost Environment Configuration (.env)
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local_development_secret_key_hacktrack_2026_super_secure

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# If using Docker: docker run --name hacktrack-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=hacktrack_dev -p 5432:5432 -d postgres:15
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hacktrack_dev?schema=public"

# File Upload Storage
UPLOAD_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=25

# Rate Limiting & Diagnostics
RATE_LIMIT_ENABLED=true
